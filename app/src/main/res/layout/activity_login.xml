<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <View
        android:layout_width="360dp"
        android:layout_height="560dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-145dp"
        android:layout_marginTop="-70dp"
        android:background="@drawable/bg_login_blob_top"
        android:alpha="0.78" />

    <View
        android:layout_width="300dp"
        android:layout_height="420dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-180dp"
        android:layout_marginBottom="-70dp"
        android:background="@drawable/bg_login_blob_top"
        android:alpha="0.55" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/themeToggleBox"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_gravity="end"
                android:background="@drawable/bg_mode_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/normalModeBtn"
                    android:layout_width="104dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_mode_active"
                    android:drawableStart="@drawable/ic_sun_login"
                    android:drawablePadding="5dp"
                    android:gravity="center"
                    android:text="Normal"
                    android:textColor="@color/transiva_blue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/darkModeBtn"
                    android:layout_width="84dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="☾ Dark"
                    android:textColor="@color/transiva_muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/loginLogo"
                android:layout_width="185dp"
                android:layout_height="78dp"
                android:layout_marginTop="42dp"
                android:adjustViewBounds="true"
                android:contentDescription="Transiva"
                android:scaleType="fitCenter"
                android:src="@drawable/transiva_logo" />

            <TextView
                android:id="@+id/loginTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Masuk Transiva"
                android:textColor="@color/transiva_title"
                android:textSize="31sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/loginSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Masuk untuk mulai pesan atau menerima order"
                android:textColor="@color/transiva_subtitle"
                android:textSize="15.5sp" />

            <LinearLayout
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_card_login"
                android:elevation="8dp"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingTop="28dp"
                android:paddingEnd="26dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/loginMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:textColor="@color/error"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nama Pengguna"
                    android:textColor="@color/transiva_text"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_login"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_user_login" />

                    <EditText
                        android:id="@+id/loginUsername"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:hint="Masukkan Nama Pengguna"
                        android:inputType="text"
                        android:maxLines="1"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/transiva_text"
                        android:textColorHint="@color/transiva_hint"
                        android:textSize="15.5sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Kata Sandi"
                    android:textColor="@color/transiva_text"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_login"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_lock_login" />

                    <EditText
                        android:id="@+id/loginPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:hint="Masukkan Kata Sandi"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/transiva_text"
                        android:textColorHint="@color/transiva_hint"
                        android:textSize="15.5sp" />

                    <ImageButton
                        android:id="@+id/togglePasswordBtn"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@color/transparent"
                        android:contentDescription="Tampilkan sandi"
                        android:padding="6dp"
                        android:src="@drawable/ic_eye_login" />
                </LinearLayout>

                <Button
                    android:id="@+id/loginBtn"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_login_button"
                    android:drawableEnd="@drawable/ic_arrow_right_login"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:text="Masuk"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="56dp"
                        android:layout_height="1dp"
                        android:background="@color/transiva_divider" />

                    <TextView
                        android:id="@+id/toRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:text="Belum punya akun? Daftar"
                        android:textColor="@color/transiva_blue"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="1dp"
                        android:background="@color/transiva_divider" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/versionBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_version_box"
                    android:gravity="center_vertical"
                    android:minHeight="88dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:src="@drawable/ic_shield_login" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/versionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Versi Aplikasi : 1.0"
                            android:textColor="@color/transiva_text"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Aplikasi selalu diperbarui untuk pengalaman terbaik Anda"
                            android:textColor="@color/transiva_subtitle"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/checkUpdateBtn"
                        android:layout_width="112dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_update_btn"
                        android:gravity="center"
                        android:text="Cek Pembaharuan"
                        android:textColor="@color/transiva_blue"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/privacyBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kebijakan Privasi"
                        android:textColor="@color/transiva_blue"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:text="|"
                        android:textColor="@color/transiva_border"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/termsBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Syarat &amp; Ketentuan"
                        android:textColor="@color/transiva_blue"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
